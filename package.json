    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^4.6.0",
    "playwright": "^1.65.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
