{
  "name": "platform-heat-sim",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "站台客流热力仿真工具 - TypeScript / React / three.js / three-mesh-bvh",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5199 --strictPort",
    "build": "tsc --noEmit && vite build",
