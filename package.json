    "typecheck": "tsc --noEmit",
    "test": "node --test tests/core.test.ts",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "bench": "node tests/cap.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.179.1",
