{
  "name": "fairing-separation-vfx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "整流罩分离视效仿真工具 (SolidJS + three.js + three-mesh-bvh)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node tests/smoke.mjs",
    "test:collision": "node tests/engine-scan.mjs",
    "test:trajectory": "node tests/trajectory-diag.mjs",
    "test:export": "node tests/export-check.mjs"
  },
  "dependencies": {
    "solid-js": "^1.9.20",
    "three": "^0.170.0",
    "three-mesh-bvh": "^0.8.3"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "playwright": "^1.65.1",
    "typescript": "~5.7.0",
    "vite": "^6.4.6",
    "vite-plugin-solid": "^2.11.17"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
