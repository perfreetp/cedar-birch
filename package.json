{
  "name": "weld-bead-section-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "焊接接头多层多道焊道工艺剖切可视化工具 (SolidJS + three.js + three-mesh-bvh)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:headless": "node scripts/headless-check.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "earcut": "^3.2.4",
    "solid-js": "^1.9.3",
    "three": "^0.169.0",
    "three-mesh-bvh": "^0.9.18"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-solid": "^2.10.2"
  }
}
